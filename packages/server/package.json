{
  "name": "plume-ssr-server",
  "version": "1.1.3",
  "description": "A framework to create an SSR server for a Plume project",
  "author": "Aurélien Manteaux <amanteaux@coreoz.com> (https://coreoz.com)",
  "contributors": [
    "Wail Latif <wlatif@coreoz.com> (https://coreoz.com)"
  ],
  "repository": "https://github.com/coreoz/plume-ssr",
  "homepage": "https://github.com/coreoz/plume-ssr",
  "license": "Apache-2.0",
  "keywords": [
    "react",
    "ssr",
    "plume"
  ],
  "scripts": {
    "build": "yarn build:cjs && yarn build:esm && yarn build:types",
    "build:cjs": "swc src --config-file .swcrc -C module.type=commonjs --out-dir build/cjs --strip-leading-paths --ignore \"**/tests/**\"",
    "build:esm": "swc src --config-file .swcrc -C module.type=es6 --out-dir build/esm --strip-leading-paths --ignore \"**/tests/**\"",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "typescript": "tsc --noEmit -p tsconfig.json",
    "eslint": "eslint src --ext .ts",
    "test": "vitest run",
    "prepare-release": "yarn clean && yarn typescript && yarn eslint && yarn test && yarn build"
  },
  "main": "build/cjs/index.js",
  "typings": "build/esm/index.d.ts",
  "module": "build/esm/index.js",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "packageManager": "yarn@4.12.0",
  "peerDependencies": {
    "dayjs": "^1.0.0",
    "esbuild": "^0.16.12",
    "express": "^4.18.2",
    "micro-observables": "^1.7.2",
    "minimist": "^1.0.0",
    "plume-ssr-browser": "workspace:^",
    "plume-ts-di": "^1.2.3",
    "rollup": "^3.8.1",
    "simple-http-rest-client": "^1.0.0",
    "simple-logging-system": "^1.0.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^4.2.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/express": "^4.17.15",
    "@types/minimist": "^1.2.2",
    "@types/node": "^24.1.0",
    "@types/react": "^19.2.9",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/coverage-v8": "^5.0.1",
    "dayjs": "^1.11.5",
    "esbuild": "^0.16.12",
    "eslint": "^9.39.2",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-import": "^2.31.0",
    "express": "^4.18.2",
    "micro-observables": "^1.7.2",
    "minimist": "^1.2.7",
    "plume-ssr-browser": "workspace:^",
    "plume-ts-di": "^1.2.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^6.6.2",
    "rollup": "^3.8.1",
    "simple-http-rest-client": "^2.0.2",
    "simple-logging-system": "^1.1.0",
    "swc-class-decorator-plugin": "^1.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "files": [
    "build/**/*.*"
  ]
}
