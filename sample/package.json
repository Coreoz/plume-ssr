{
  "name": "sample-plume-ssr",
  "version": "1.1.3",
  "private": true,
  "dependencies": {
    "@fontsource/roboto": "^4.5.8",
    "dayjs": "^1.11.5",
    "micro-observables": "^1.7.2",
    "minimist": "^1.2.7",
    "plume-ssr-browser": "workspace:*",
    "plume-ssr-server": "workspace:*",
    "plume-ts-di": "^1.2.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "7.71.1",
    "react-router-dom": "^6.6.1",
    "simple-http-request-builder": "^2.0.0",
    "simple-http-rest-client": "^2.0.2",
    "simple-job-scheduler": "^1.1.2",
    "simple-logging-system": "^1.1.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^4.2.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@types/express": "^4.17.15",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@types/validator": "^13.7.7",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^7.4.0",
    "esbuild": "^0.16.11",
    "esbuild-runner": "^2.2.2",
    "eslint": "^9.39.2",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-plugin-compat": "^6.0.2",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-react": "^7.31.11",
    "eslint-plugin-react-hooks": "^4.6.0",
    "express": "^4.18.2",
    "history": "5.3.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.4.18",
    "sass": "^1.97.3",
    "stylelint": "^14.13.0",
    "stylelint-config-recommended-scss": "^7.0.0",
    "stylelint-scss": "^4.3.0",
    "swc-class-decorator-plugin": "^1.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not op_mini all",
    "Firefox >= 75",
    "Chrome >= 80",
    "Firefox >= 75",
    "safari >= 12"
  ],
  "scripts": {
    "start": "concurrently \"yarn watch-ts\" \"yarn watch-js\"",
    "start-server": "concurrently \"yarn watch-ts\" \"yarn run-ssr\"",
    "watch-ts": "concurrently \"swc src --config-file .swcrc --out-dir ts-built/src --strip-leading-paths -w\" \"swc server-ssr --config-file .swcrc --out-dir ts-built/server-ssr --strip-leading-paths -w\"",
    "watch-js": "vite",
    "build-ts": "swc src --config-file .swcrc --out-dir ts-built/src --strip-leading-paths && swc server-ssr --config-file .swcrc --out-dir ts-built/server-ssr --strip-leading-paths",
    "run-ssr": "yarn build-ts && yarn build-server && node build/server/index.js",
    "build": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\" && yarn build-ts && yarn build-client && yarn build-server",
    "build-client": "vite build --outDir build/client",
    "build-server": "esr building/ssr-compiler.ts",
    "stylelint": "stylelint 'assets/scss/**/*.scss'",
    "eslint": "eslint src --fix --ext .ts,.tsx",
    "typescript": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "packageManager": "yarn@4.12.0"
}
