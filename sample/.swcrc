{
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": true,
      "dynamicImport": true
    },
    "target": "es2022",
    "keepClassNames": true,
    "transform": {
      "react": {
        "runtime": "classic"
      }
    },
    "experimental": {
      "plugins": [
        ["swc-class-decorator-plugin", { "log": "Info" }]
      ],
      "runPluginFirst": true
    }
  },
  "module": {
    "type": "es6"
  },
  "sourceMaps": true
}
